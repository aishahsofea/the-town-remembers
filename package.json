{
  "name": "the-town-remembers",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.json && pnpm --filter @the-town-remembers/web build",
    "build:id": "node scripts/build-id.mjs",
    "cdk:synth": "node scripts/synth.mjs",
    "check:boundaries": "node scripts/check-workspace-boundaries.mjs",
    "check:bundle": "node scripts/check-bundle-safety.mjs",
    "db:doctor": "node scripts/db-doctor.mjs",
    "db:down": "node scripts/cockroach.mjs stop",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "db:snapshot": "node scripts/db-snapshot.mjs",
    "db:status": "node scripts/cockroach.mjs status",
    "db:types": "node scripts/db-types.mjs",
    "db:up": "node scripts/cockroach.mjs start",
    "dev": "node scripts/dev.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:content": "vitest run --project config packages/content",
    "test:contracts": "vitest run --project contracts",
    "test:db": "vitest run --project database",
    "test:e2e": "playwright test",
    "test:rules": "vitest run --project rules",
    "test:tooling": "node --test scripts/*.test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.tests.node.json && tsc -p tsconfig.tests.web.json",
    "validate": "pnpm format:check && pnpm check:boundaries && pnpm test:tooling && pnpm typecheck && pnpm lint && TTR_REQUIRE_DB_TESTS=1 pnpm test && pnpm build && pnpm check:bundle && pnpm cdk:synth && pnpm test:e2e"
  },
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.20.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@the-town-remembers/database-admin": "workspace:*",
    "@the-town-remembers/runtime-config": "workspace:*",
    "@the-town-remembers/town-seed": "workspace:*",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.15.6",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "pg": "^8.16.3",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}

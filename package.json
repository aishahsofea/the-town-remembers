{
  "name": "the-town-remembers",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.json && pnpm --filter @the-town-remembers/web build",
    "build:id": "node scripts/build-id.mjs",
    "cdk:synth": "node scripts/synth.mjs",
    "check:assets": "node scripts/check-asset-keys.mjs",
    "check:boundaries": "node scripts/check-workspace-boundaries.mjs",
    "check:bundle": "node scripts/check-bundle-safety.mjs",
    "check:source-text": "node scripts/check-source-text.mjs",
    "check:test-policy": "node scripts/check-test-policy.mjs",
    "db:doctor": "node scripts/db-doctor.mjs",
    "db:down": "node scripts/cockroach.mjs stop",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "db:snapshot": "node scripts/db-snapshot.mjs",
    "db:status": "node scripts/cockroach.mjs status",
    "db:types": "node scripts/db-types.mjs",
    "db:up": "node scripts/cockroach.mjs start",
    "dev": "node scripts/dev.mjs",
    "embed:seed": "node scripts/embed-seed.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "model:prewarm": "node scripts/model-prewarm.mjs",
    "prompts:eval": "node scripts/prompts-eval.mjs",
    "prompts:eval:live": "TTR_PROMPTS_EVAL_LIVE=1 node scripts/prompts-eval.mjs",
    "rules:scenario": "node scripts/rules-scenario.mjs",
    "test": "vitest run --coverage",
    "test:api": "vitest run --project api",
    "test:content": "vitest run --project config packages/content",
    "test:contracts": "vitest run --project contracts",
    "test:db": "vitest run --project database",
    "test:e2e": "playwright test",
    "test:e2e:live": "TTR_E2E_LIVE_MODEL=1 playwright test e2e/phase-04-grounded-memory.spec.ts",
    "test:model": "vitest run --project model-runtime",
    "test:model:live": "TTR_MODEL_LIVE_TESTS=1 vitest run --project model-live",
    "test:rules": "vitest run --project rules",
    "test:tooling": "node --test scripts/*.test.mjs",
    "test:watch": "vitest",
    "town:new": "node scripts/town-new.mjs",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.tests.node.json && tsc -p tsconfig.tests.web.json && tsc -p tsconfig.tests.e2e.json",
    "validate": "pnpm format:check && pnpm check:source-text && pnpm check:boundaries && pnpm check:assets && pnpm check:test-policy && pnpm typecheck && pnpm test:tooling && pnpm lint && TTR_REQUIRE_DB_TESTS=1 pnpm test && pnpm prompts:eval && pnpm build && pnpm check:bundle && pnpm cdk:synth && pnpm test:e2e",
    "validate:profile": "node scripts/validate-profile.mjs"
  },
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.20.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "warn"
    }
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@the-town-remembers/content": "workspace:*",
    "@the-town-remembers/database-admin": "workspace:*",
    "@the-town-remembers/game-server": "workspace:*",
    "@the-town-remembers/model-runtime": "workspace:*",
    "@the-town-remembers/rules": "workspace:*",
    "@the-town-remembers/runtime-config": "workspace:*",
    "@the-town-remembers/test-support": "workspace:*",
    "@the-town-remembers/town-seed": "workspace:*",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.15.6",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "pg": "^8.16.3",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}

# Environment variable names and safe placeholders. Copy to `.env` for local
# work. Never commit a real value: `.env` and `.env.*` are ignored except for
# this example.
#
# Categories are separate on purpose. A browser-public variable is compiled
# into the bundle and is world-readable. An operator variable belongs only to
# an operator shell and must never appear in a Lambda environment.

# --- Shared runtime identity ------------------------------------------------
# local | development | production
TTR_ENV=local
# Release or Git identity. `unknown` is accepted only when TTR_ENV=local.
TTR_BUILD_ID=unknown
# debug | info | warn | error
TTR_LOG_LEVEL=info

# --- Game API runtime -------------------------------------------------------
# Exact application origin used for same-origin checks.
TTR_APP_ORIGIN=http://localhost:5173

# --- Deployment (AWS CDK) ---------------------------------------------------
TTR_AWS_REGION=us-east-1
# Optional; omit to synthesize without a bound account.
TTR_AWS_ACCOUNT=

# --- Test harness -----------------------------------------------------------
TTR_E2E_API_PORT=5174
TTR_E2E_WEB_PORT=5173

# --- Browser-public (compiled into the bundle, world-readable) --------------
VITE_TTR_ENV=local
VITE_TTR_BUILD_ID=unknown

# --- Operator only (never set in a Lambda environment) ----------------------
# Migration administrator credential. Held by an operator shell for the
# duration of one command.
TTR_MIGRATION_DATABASE_URL=postgresql://migration_admin:placeholder@localhost:26257/defaultdb

# Environment variable names and safe placeholders. Copy to `.env` for local
# work. Never commit a real value: `.env` and `.env.*` are ignored except for
# this example.
#
# Categories are separate on purpose. A browser-public variable is compiled
# into the bundle and is world-readable. An operator variable belongs only to
# an operator shell and must never appear in a Lambda environment.

# --- Shared runtime identity ------------------------------------------------
# local | development | production
TTR_ENV=local
# Release or Git identity. `unknown` is accepted only when TTR_ENV=local.
TTR_BUILD_ID=unknown
# debug | info | warn | error
TTR_LOG_LEVEL=info

# --- Game API runtime -------------------------------------------------------
# Exact application origin used for same-origin checks.
TTR_APP_ORIGIN=http://localhost:5173
# Port the local node:http adapter binds. Shared with the test harness.
TTR_API_PORT=5174

# --- Deployment (AWS CDK) ---------------------------------------------------
TTR_AWS_REGION=us-east-1
# Optional; omit to synthesize without a bound account.
TTR_AWS_ACCOUNT=

# --- Test harness -----------------------------------------------------------
TTR_WEB_PORT=5173
# Ports the pinned local CockroachDB node binds. `pnpm db:up` starts it.
TTR_TEST_DB_PORT=26257
TTR_TEST_DB_HTTP_PORT=8081

# --- Browser-public (compiled into the bundle, world-readable) --------------
VITE_TTR_ENV=local
VITE_TTR_BUILD_ID=unknown

# --- Database runtime (least-privileged app_runtime credential) -------------
# Deployed environments must request sslmode=verify-full; the loader refuses
# anything weaker outside TTR_ENV=local.
TTR_DATABASE_URL=postgresql://app_runtime:placeholder@localhost:26257/defaultdb?sslmode=disable

# --- Operator only (never set in a Lambda environment) ----------------------
# Migration administrator credential. Held by an operator shell for the
# duration of one command.
TTR_MIGRATION_DATABASE_URL=postgresql://migration_admin:placeholder@localhost:26257/defaultdb

# --- Security (packages/game-server and apps/game-api only) -----------------
# Bearer code judges present to create a town. Placeholder only; never reuse.
TTR_JUDGE_CODE=placeholder-judge-code-change-me
# Comma-separated "<version>:<base64url-32-bytes>" list. The first entry is
# the active version; older versions stay listed so an existing invite can
# still be reconstructed after rotation.
TTR_INVITE_SIGNING_KEYS=v1:ellozwDF6MjC9aIaV_C3JAm1N0itqbhqINMe21ZurOc
# 256 bits of base64url, mixed into every session token's stored hash.
TTR_SESSION_TOKEN_PEPPER=0S_sHeUl8wqdysN8AM7JK6SHbjlnkCoCYgeWplF8k8E
# 256 bits of base64url, the HKDF root for the daily rotating IP-hash window.
TTR_IP_HASH_SECRET=ChUALDNE4I_6Qy0vPTPKExGWmvrACeAmwxbQxUUfLi4

# Dependencies and package-manager state
node_modules/
.pnpm-store/

# Local environment files. `.env.example` documents every name and
# `.env.defaults` carries committed non-secret local values; real values live
# in an ignored `.env`.
.env
.env.*
!.env.example
!.env.defaults
!.env.*.example

# Build and test output
dist/
build/
coverage/
playwright-report/
test-results/
cdk.out/
.vite/
*.tsbuildinfo

# Pinned local CockroachDB binary, its store, and its logs. `pnpm db:up`
# recreates all of it; nothing here is a source of truth.
.cockroach/

# Logs and operating-system metadata
*.log
.DS_Store

# Emitted declaration output for browser projects
dist-types/
